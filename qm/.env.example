# Secret values for this deployment. This file holds names only; copy it to .env and fill in
# the values. .env is gitignored. `qm secrets push` transfers values without persisting
# or printing them.

# Anthropic API key: bills the base model when modelProvider is "anthropic", an optional deployment fallback otherwise. (core)
# ANTHROPIC_API_KEY=  # optional

# Sender for external-user invitations sent from the admin Users tab or by chatting with QM; the same verified sender the sign-in broker uses. (core)
# AUTH_EMAIL_FROM=  # optional

# Signing key for scoped agent capabilities and egress grants; must differ from every other key. (core)
# Generate with: openssl rand -hex 32
CAPABILITY_SECRET=

# Encryption key for durable connector credentials; must differ from every other key. (core)
# Generate with: openssl rand -hex 32
CONNECTOR_SECRET_KEY=

# HMAC key shared by core and surface plugins. (core, web-ui)
# Generate with: openssl rand -hex 32
CORE_SIGNING_SECRET=

# Extra root CA (PEM content) trusted for the Postgres connection, for providers that pin a private root (e.g. Supabase's pooler). Verification stays on. (core)
# DATABASE_CA_CERT=  # optional

# PEM CA certificate used to verify the transaction pooler's TLS identity. (core)
# DATABASE_POOL_CA_CERT=  # optional

# Transaction-mode PgBouncer URL using the direct database's company credentials and database name. (core)
# DATABASE_POOL_URL=  # optional

# Comma-separated principals allowed to access Inbox, Calendar, and Design System. (web-ui)
# INBOX_USERS=  # optional

# OpenRouter API key: bills the base model when modelProvider is "openrouter", an optional deployment fallback otherwise. (core)
OPENROUTER_API_KEY=

# Signing key for portal-bound user identity; must differ from every other key. (core, web-ui)
# Generate with: openssl rand -hex 32
PORTAL_IDENTITY_SECRET=

# Public core self-API URL reachable from agent sandboxes. (core)
PUBLIC_API_URL=

# Lets core email invitations to external users, added from the admin Users tab or by chatting with QM, through Resend. (core)
# RESEND_API_KEY=  # optional

# Stable signing key for reviewed skills. (core)
# Generate with: openssl rand -hex 32
SKILL_SIGNING_SECRET=

# OpenAI API key: the Codex harness needs it (its CLI cannot do browser OAuth in a container), and it bills the base model when modelProvider is "openai". (core)
# Needed when env.core.HARNESS is "codex" or modelProvider is "openai".
# OPENAI_API_KEY=

# Deployment ownership credential held only by core and the privileged deployment operator. (core)
# Needed when aws.backgroundWorkControl is enabled.
# Generate with: openssl rand -hex 32
# DEPLOYMENT_CONTROL_SECRET=

# Fly publisher token: app-scoped for FLY_DEPLOY_SHARED_APP_NAME, organization-scoped otherwise. (core)
# Needed when env.core.DEPLOY_PROVIDER is "fly".
# FLY_DEPLOY_API_TOKEN=

# JSON array of distinct private ingress WireGuard peer configurations for shared Fly publishing. (core)
# Needed when env.core.DEPLOY_PROVIDER is "fly" and env.core.FLY_DEPLOY_SHARED_APP_NAME is set.
# FLY_DEPLOY_WIREGUARD_PEERS=

# Admin-role Porter API token for the sandbox backend and the per-deployment app publisher — Developer-role tokens fail mid-deployment with PERMISSION_DENIED. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects porter or env.core.DEPLOY_PROVIDER is "porter".
# Generate with: create an Admin-role API token in the Porter dashboard (https://dashboard.porter.run → Settings → API tokens)
# PORTER_DEPLOY_API_TOKEN=

# Fly Sprites API token for the agent-computer substrate. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects sprites.
# Generate with: sprite login   # then copy the token from ~/.sprite/credentials
# SPRITES_TOKEN=

# E2B API key used by the e2b sandbox backend (from e2b.dev dashboard). (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects e2b.
# E2B_API_KEY=

# Modal token id used by the modal sandbox backend. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects modal.
# Generate with: modal token new   # or create a token in the Modal dashboard
# MODAL_TOKEN_ID=

# Modal token secret paired with MODAL_TOKEN_ID. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects modal.
# MODAL_TOKEN_SECRET=

# smolmachines API key for the agent-computer substrate. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects smolmachines.
# Generate with: create an API key in the smolmachines console (https://smolmachines.com/console)
# SMOLMACHINES_TOKEN=

# Agent37 API key for the agent-computer substrate. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects agent37 or env.core.SANDBOX_SECONDARY_BACKEND is "agent37".
# Generate with: mint a key in the Agent37 dashboard (https://agent37.com/dashboard/cloud/api-keys)
# AGENT37_API_KEY=

# API key for Superserve sandboxes. (core)
# Needed when SANDBOX_BACKEND or SANDBOX_SCOPE_BACKENDS selects superserve.
# Generate with: create an API key in the Superserve console (https://console.superserve.ai/api-keys)
# SUPERSERVE_API_KEY=

# Postgres connection string for durable state. (core)
# Needed when the target is aws.
# DATABASE_URL=  # populated by Terraform

# HMAC key protecting public deployment-app URLs on the apps domain. (core)
# Needed when env.core.AWS_DEPLOY_APPS_DOMAIN is set or env.core.DEPLOY_APPS_DOMAIN is set.
# Generate with: openssl rand -hex 32
# AWS_DEPLOY_GATE_SECRET=

# Google OAuth client secret. (core)
# Needed when env.core.GOOGLE_OAUTH_CLIENT_ID is set.
# GOOGLE_OAUTH_CLIENT_SECRET=

# Dropbox OAuth client secret. (core)
# Needed when env.core.DROPBOX_OAUTH_CLIENT_ID is set.
# DROPBOX_OAUTH_CLIENT_SECRET=

# Linear OAuth client secret. (core)
# Needed when env.core.LINEAR_OAUTH_CLIENT_ID is set.
# LINEAR_OAUTH_CLIENT_SECRET=

# Optional at first deploy; Slack bot OAuth token. (slack)
# Needed when the slack service is enabled (optional even then).
# SLACK_BOT_TOKEN=

# Optional at first deploy; Slack Socket Mode app token. (slack)
# Needed when the slack service is enabled (optional even then).
# SLACK_APP_TOKEN=

# Slack request-signing secret (from the Slack app's Basic Information page); HTTP events mode only. (slack)
# Needed when the slack service is enabled and env.slack.SLACK_EVENTS_MODE is "http".
# SLACK_SIGNING_SECRET=

# Deployment-specific OIDC client identifier when it should not be committed. (portal)
# Needed when the portal service is enabled and the auth service is not enabled and env.portal.OIDC_CLIENT_ID is not set.
# OIDC_CLIENT_ID=

# Client secret issued by an external identity provider; the built-in auth broker mints its own instead. (portal)
# Needed when the portal service is enabled and the auth service is not enabled.
# OIDC_CLIENT_SECRET=

# Deployment-specific OIDC workspace trust boundary when it should not be committed. (portal)
# Needed when the portal service is enabled and the auth service is not enabled and none of env.portal.{OIDC_ALLOWED_EMAILS, OIDC_ALLOWED_EMAIL_DOMAIN, PORTAL_EXPECTED_TEAM_ID} are set.
# PORTAL_EXPECTED_TEAM_ID=

# Cookie-signing secret for portal sessions. (portal)
# Needed when the portal service is enabled.
# Generate with: openssl rand -hex 32
# PORTAL_SESSION_SECRET=

# P-256 private JSON Web Key the broker signs id_tokens with; the portal verifies it through the broker's JWKS. (auth)
# Needed when the auth service is enabled.
# Generate with: node -e "const {generateKeyPairSync}=require('node:crypto');process.stdout.write(JSON.stringify(generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'})))"
# AUTH_SIGNING_JWK=

# Key the broker seals sign-in links, authorization codes, and access tokens with; must differ from every other key. (auth)
# Needed when the auth service is enabled.
# Generate with: openssl rand -hex 32
# AUTH_TOKEN_SECRET=

# Client secret the portal presents to the built-in auth broker; the CLI generates it for both sides. (auth)
# Needed when the auth service is enabled.
# Generate with: openssl rand -hex 32
# AUTH_CLIENT_SECRET=

# Comma-separated email addresses allowed to sign in through the built-in broker. (auth)
# Needed when the auth service is enabled and env.auth.AUTH_ALLOWED_EMAIL_DOMAIN is not set.
# AUTH_ALLOWED_EMAILS=

# Optional <email>:<scrypt-hash> entries that may sign in with a password while email or an identity provider is still being set up; each address must also be allowed to sign in. (auth)
# Needed when the auth service is enabled (optional even then).
# AUTH_PASSWORD_USERS=

# SMTP relay hostname used to deliver sign-in links. (auth)
# Needed when the auth service is enabled and env.auth.AUTH_EMAIL_TRANSPORT is "smtp".
# SMTP_HOST=

# SMTP username for the sign-in-link relay. (auth)
# Needed when the auth service is enabled and env.auth.AUTH_EMAIL_TRANSPORT is "smtp".
# SMTP_USERNAME=

# SMTP password for the sign-in-link relay. (auth)
# Needed when the auth service is enabled and env.auth.AUTH_EMAIL_TRANSPORT is "smtp".
# SMTP_PASSWORD=
